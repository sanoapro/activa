                                    </td>
                                    <td class="col-alumnos" data-ck="4fbcd7ad07"
                                        data-label="Creación de calendarios secundarios" data-p="alumnos"
                                        style="text-align: left;">Desactivada</td>
                                    <td class="col-personal" data-ck="df82978b57"
                                        data-label="Creación de calendarios secundarios" data-p="personal"
                                        style="text-align: left;">Permitida</td>
                                    <td style="text-align: left;">Limpieza y control.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </article>
            <article class="card" data-card="3.7 · Sites, Keep, Tasks, Vids, Forms">
