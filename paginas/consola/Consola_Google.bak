                href="#sec-parte-5-chromeos-politicas-de-dispositivo">Parte 5</a><a class="top-link"
                href="#sec-parte-6-chromeos-y-chrome-politicas-de-usuarios-y-navegadore">Parte 6</a><a class="top-link"
                href="#sec-parte-7-apps-y-extensiones-de-chrome">Parte 7</a><a class="top-link"
                href="#sec-parte-8-redes-y-certificados">Parte 8</a><a class="top-link"
                href="#sec-parte-9-inventario-y-ciclo-de-vida-de-dispositivos">Parte 9</a><a class="top-link"
                href="#sec-parte-10-dispositivos-moviles-y-otros-endpoints">Parte 10</a><a class="top-link"
                href="#sec-parte-11-matriz-de-evasion-tecnica-contramedida">Parte 11</a><a class="top-link"
                href="#sec-parte-12-el-caso-especial-equipos-que-se-van-a-casa">Parte 12</a><a class="top-link"
                href="#sec-parte-13-plan-de-implantacion">Parte 13</a><a class="top-link"
                href="#sec-parte-14-verificacion-como-comprobar-que-funciona">Parte 14</a><a class="top-link"
                href="#sec-parte-15-errores-frecuentes">Parte 15</a><a class="top-link"
                href="#sec-parte-16-reversion-y-respuesta-a-incidentes">Parte 16</a><a class="top-link"
                href="#sec-parte-17-continuidad-respaldo-fin-de-curso-y-egreso">Parte 17</a><a class="top-link"
                href="#sec-anexo-a-referencia-rapida-de-rutas">Anexo A</a><a class="top-link"
                href="#sec-anexo-b-los-20-ajustes-de-mayor-impacto">Anexo B</a><a class="top-link"
                href="#sec-anexo-c-nota-de-vigencia">Anexo C</a><a class="top-link"
                href="#sec-anexo-d-lo-que-este-manual-no-resuelve">Anexo D</a></nav>
    </header>

    <div class="scrim" id="scrim"></div>

    <aside class="sidebar" id="sidebar">
        <div class="nav-title">Contenido</div>
        <div class="nav-group"
            data-search="cómo usar este documento los tres niveles donde se aplica una política convenciones">
            <a class="nav-item" href="#sec-como-usar-este-documento"><span class="nav-kicker"></span><span
                    class="nav-name">Cómo usar este documento</span></a>
            <div class="nav-subs"><a class="nav-sub"
                    href="#como-usar-este-documento--los-tres-niveles-donde-se-aplica-una-politica">Los tres niveles
                    donde se aplica una política</a><a class="nav-sub"
                    href="#como-usar-este-documento--convenciones">Convenciones</a></div>
        </div>
        <div class="nav-group"
            data-search="parte 0 — arquitectura previa: unidades organizativas estructura recomendada (usuarios) estructura recomendada (dispositivos) reglas de oro sincronización de identidad">
            <a class="nav-item" href="#sec-parte-0-arquitectura-previa-unidades-organizativas"><span
                    class="nav-kicker">Parte 0</span><span class="nav-name">Arquitectura previa: Unidades
                    Organizativas</span></a>
            <div class="nav-subs"><a class="nav-sub"
                    href="#parte-0-arquitectura-previa-unidades-organizativas--estructura-recomendada-usuarios">Estructura
                    recomendada (usuarios)</a><a class="nav-sub"
                    href="#parte-0-arquitectura-previa-unidades-organizativas--estructura-recomendada-dispositivos">Estructura
                    recomendada (dispositivos)</a><a class="nav-sub"
                    href="#parte-0-arquitectura-previa-unidades-organizativas--reglas-de-oro">Reglas de oro</a><a
                    class="nav-sub"
                    href="#parte-0-arquitectura-previa-unidades-organizativas--sincronizacion-de-identidad">Sincronización
