            <article class="card" data-card="3.8 · Servicios adicionales de Google">
                <div class="card-head"><span class="card-num">3.8</span>
                    <h2 id="parte-3-servicios-de-google-workspace--ruta-38-apps-servicios-adicionales-de-google">
                        Servicios adicionales de Google</h2>
                </div>
                <div class="routebar"><svg aria-hidden="true" fill="currentColor" height="15" viewbox="0 0 24 24"
                        width="15">
                        <path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z">
