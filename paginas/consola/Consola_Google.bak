<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Manual de blindaje · Google Admin Console</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Roboto+Mono:wght@400;500&display=swap"
        rel="stylesheet">
    <style>
        :root {
            --blue: #1a73e8;
            --blue-d: #174ea6;
            --blue-bg: #e8f0fe;
            --blue-line: #a8c7fa;
            --blue-g: #4285f4;
            --green: #188038;
            --green-bg: #e6f4ea;
            --green-line: #a8dab5;
            --green-g: #34a853;
            --red: #d93025;
            --red-bg: #fce8e6;
            --red-g: #ea4335;
            --yellow: #f9ab00;
            --yellow-bg: #fef7e0;
            --yellow-ink: #8a5b00;
            --yellow-g: #fbbc04;
            --purple: #8430ce;
            --purple-bg: #f3e8fd;
            --ink: #202124;
            --ink-2: #5f6368;
            --ink-3: #80868b;
            --line: #e3e5e8;
            --line-soft: #edeef0;
            --surface: #f8f9fa;
            --sidebar: 288px;
            --top: 64px;
            --r: 16px;
            --shadow: 0 1px 2px rgba(60, 64, 67, .06), 0 4px 14px -6px rgba(60, 64, 67, .14);
            --font: "Google Sans", "Google Sans Text", "Product Sans", Roboto, -apple-system, "Segoe UI", Arial, sans-serif;
            --mono: "Roboto Mono", "SF Mono", Menlo, Consolas, monospace;
        }

        * {
            box-sizing: border-box
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: calc(var(--top) + 82px)
        }

        body {
            margin: 0;
            font-family: var(--font);
            color: var(--ink);
            background: #fbfbfd;
            font-size: 14px;
            line-height: 1.62;
            -webkit-font-smoothing: antialiased
        }

        /* ===== fondo: esferas Google difuminadas ===== */
        .orbs {
            position: fixed;
            inset: 0;
            z-index: -2;
            overflow: hidden;
            pointer-events: none
        }

        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(90px);
            opacity: .5
        }

        .o1 {
            width: 660px;
            height: 660px;
            background: var(--blue-g);
            top: -200px;
            left: -120px;
            opacity: .55
        }

        .o2 {
            width: 520px;
            height: 520px;
            background: var(--red-g);
            top: -160px;
            left: 34%;
            opacity: .34
        }

        .o3 {
            width: 620px;
            height: 620px;
            background: var(--yellow-g);
            top: 60px;
            right: -200px;
            opacity: .42
        }

        .o4 {
            width: 560px;
            height: 560px;
            background: var(--green-g);
            top: 36%;
            left: -160px;
            opacity: .30
        }

        .o5 {
            width: 760px;
            height: 760px;
            background: var(--blue-g);
            bottom: -360px;
            right: -140px;
            opacity: .26
        }

        .o6 {
            width: 440px;
            height: 440px;
            background: var(--red-g);
            bottom: 18%;
            left: 26%;
            opacity: .16
        }

        .grain {
            position: fixed;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            background: linear-gradient(180deg, rgba(255, 255, 255, .28) 0, rgba(255, 255, 255, .62) 640px, rgba(255, 255, 255, .72) 100%)
        }

        /* ===== TOPBAR ===== */
        .topbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: var(--top);
            z-index: 60;
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 0 16px;
            background: rgba(255, 255, 255, .82);
            backdrop-filter: saturate(180%) blur(14px);
            -webkit-backdrop-filter: saturate(180%) blur(14px);
            border-bottom: 1px solid var(--line)
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 11px;
            min-width: 0
        }

        .burger {
            display: none;
            border: 0;
            background: transparent;
            padding: 8px;
            border-radius: 50%;
            cursor: pointer;
            color: var(--ink-2)
        }

        .burger:hover {
            background: var(--surface)
        }

        .logo {
            width: 32px;
            height: 32px;
            flex: none;
            border-radius: 9px;
            position: relative;
            overflow: hidden;
            background: conic-gradient(from 210deg, var(--blue-g), var(--red-g), var(--yellow-g), var(--green-g), var(--blue-g))
        }

        .logo::after {
            content: "";
            position: absolute;
            inset: 7px;
            border-radius: 50%;
            background: #fff
        }

        .brand-text b {
            display: block;
            font-size: 15px;
            font-weight: 500;
            line-height: 1.2;
            white-space: nowrap
        }

        .brand-text span {
            display: block;
            font-size: 11px;
            color: var(--ink-3);
            line-height: 1.25
        }

        .search {
            flex: 1;
            max-width: 400px;
            position: relative
        }

        .search input {
            width: 100%;
            height: 40px;
            border: 1px solid transparent;
            background: var(--surface);
            border-radius: 20px;
            padding: 0 16px 0 44px;
            font: inherit;
            font-size: 13.5px;
            color: var(--ink);
            outline: none;
            transition: .15s
        }

        .search input:focus {
            background: #fff;
            border-color: var(--blue-line);
            box-shadow: 0 1px 8px rgba(26, 115, 232, .16)
        }

        .search>svg {
            position: absolute;
            left: 15px;
            top: 11px;
            color: var(--ink-3)
        }

        .topnav {
            display: flex;
            gap: 2px;
            overflow-x: auto;
            flex: 1;
            scrollbar-width: none;
            -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 22px), transparent);
            mask-image: linear-gradient(to right, #000 calc(100% - 22px), transparent)
        }

        .topnav::-webkit-scrollbar {
            display: none
        }

        .top-link {
            flex: none;
            font-size: 12px;
            font-weight: 500;
            color: var(--ink-2);
            text-decoration: none;
            padding: 6px 11px;
            border-radius: 16px;
            white-space: nowrap
        }

        .top-link:hover {
            background: var(--surface);
            color: var(--blue)
        }

        .top-link.active {
            background: var(--blue-bg);
            color: var(--blue-d)
        }

        .filter {
            display: flex;
            flex: none;
            border: 1px solid var(--line);
            border-radius: 20px;
            overflow: hidden;
            background: #fff
        }

        .filter button {
            border: 0;
            background: #fff;
            font: inherit;
            font-size: 12px;
            font-weight: 500;
            color: var(--ink-2);
            padding: 8px 14px;
            cursor: pointer;
            white-space: nowrap;
            border-right: 1px solid var(--line-soft);
            transition: .15s
        }

        .filter button:last-child {
            border-right: 0
        }

        .filter button:hover {
            background: var(--surface)
        }

        .filter button[data-v="alumnos"].on {
            background: var(--blue);
            color: #fff
        }

        .filter button[data-v="personal"].on {
            background: var(--green);
            color: #fff
        }

        .filter button[data-v="todo"].on {
            background: var(--ink);
            color: #fff
        }

        /* ===== SIDEBAR ===== */
        .sidebar {
            position: fixed;
            top: var(--top);
            left: 0;
            bottom: 0;
            width: var(--sidebar);
            z-index: 50;
            background: rgba(255, 255, 255, .9);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-right: 1px solid var(--line);
            overflow-y: auto;
            padding: 14px 10px 72px
        }

        .sidebar::-webkit-scrollbar {
            width: 8px
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: #dadce0;
            border-radius: 4px
        }

        .nav-title {
            font-size: 11px;
            font-weight: 500;
            color: var(--ink-3);
            padding: 6px 14px 8px
        }

        .nav-item {
            display: flex;
            align-items: baseline;
            gap: 9px;
            padding: 9px 14px;
            border-radius: 0 22px 22px 0;
            text-decoration: none;
            color: var(--ink);
            font-size: 13.5px;
            font-weight: 500;
            line-height: 1.35
        }

        .nav-item:hover {
            background: var(--surface)
        }

        .nav-item.active {
            background: var(--blue-bg);
            color: var(--blue-d)
        }

        .nav-kicker {
            flex: none;
            font-size: 10.5px;
            font-weight: 700;
            color: var(--ink-3);
            min-width: 50px;
            font-variant-numeric: tabular-nums
        }

        .nav-item.active .nav-kicker {
            color: var(--blue)
        }

        .nav-subs {
            display: none;
            padding: 2px 0 8px;
            margin-left: 36px;
            border-left: 2px solid var(--line-soft)
        }

        .nav-group.open .nav-subs {
            display: block
        }

        .nav-sub {
            display: block;
            padding: 6px 14px 6px 16px;
            font-size: 12.5px;
            color: var(--ink-2);
            text-decoration: none;
            border-left: 2px solid transparent;
            margin-left: -2px
        }

        .nav-sub:hover {
            color: var(--blue)
        }

        .nav-sub.active {
            color: var(--blue-d);
            font-weight: 500;
            border-left-color: var(--blue)
        }

        .nav-group.hidden {
            display: none
        }

        .no-results {
            padding: 22px 16px;
            color: var(--ink-3);
            font-size: 13px;
            display: none
        }

        /* ===== LAYOUT ===== */
        main {
            margin-left: var(--sidebar);
            padding: calc(var(--top) + 34px) 48px 140px;
            max-width: 1230px
        }

        /* ===== HERO ===== */
        .hero {
            position: relative;
            border-radius: 28px;
            padding: 48px 44px 38px;
            margin-bottom: 58px;
            background: rgba(255, 255, 255, .40);
            backdrop-filter: blur(26px) saturate(150%);
            -webkit-backdrop-filter: blur(26px) saturate(150%);
            border: 1px solid rgba(255, 255, 255, .85);
            box-shadow: 0 24px 70px -34px rgba(60, 64, 67, .45)
        }

        .hero-top {
            display: grid;
            grid-template-columns: 1.12fr .88fr;
            gap: 40px;
            align-items: start
        }

        .levels {
            background: rgba(255, 255, 255, .72);
            border: 1px solid var(--line);
            border-radius: 18px;
            padding: 20px 22px
        }

        .levels h4 {
            margin: 0 0 4px;
            font-size: 13.5px;
            font-weight: 500
        }

        .levels>p {
            margin: 0 0 16px;
            font-size: 12px;
            color: var(--ink-3);
            max-width: none
        }

        .lvl {
            display: flex;
            gap: 12px;
            padding: 12px 14px;
            border-radius: 12px;
            background: #fff;
            border: 1px solid var(--line);
            margin-bottom: 9px
        }

        .lvl:last-child {
            margin-bottom: 0
        }

        .lvl i {
            flex: none;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            margin-top: 5px
        }

        .lvl b {
            display: block;
            font-size: 12.5px;
            font-weight: 500;
            line-height: 1.3
        }

        .lvl span {
            display: block;
            font-size: 11.5px;
            color: var(--ink-3);
            line-height: 1.45;
            margin-top: 2px
        }

        @media (max-width:1080px) {
            .hero-top {
                grid-template-columns: 1fr;
                gap: 26px
            }
        }

        .hero-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 20px;
            padding: 5px 14px 5px 8px;
            font-size: 12px;
            font-weight: 500;
            color: var(--ink-2);
            margin-bottom: 22px
        }

        .dots {
            display: inline-flex;
            gap: 3px
        }

        .dots i {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            display: block
        }

        .hero h1 {
            font-size: clamp(30px, 4.2vw, 46px);
            font-weight: 300;
            line-height: 1.1;
            margin: 0 0 18px;
            letter-spacing: -1.2px;
            max-width: 16ch
        }

        .hero h1 em {
            font-style: normal;
            font-weight: 500;
            background: linear-gradient(92deg, var(--blue-g), var(--red-g) 42%, var(--yellow-g) 68%, var(--green-g));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent
        }

        .hero-lead {
            font-size: 16px;
            color: var(--ink-2);
            max-width: 62ch;
            margin: 0 0 30px;
            line-height: 1.65;
            font-weight: 400
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            border: 1px solid var(--line);
            border-radius: 14px;
            overflow: hidden;
            background: rgba(255, 255, 255, .78);
            margin: 0;
            width: 100%
        }

        .stat {
            padding: 14px 18px;
            border-right: 1px solid var(--line-soft)
        }

        .stat:last-child {
            border-right: 0
        }

        .stat b {
            display: block;
            font-size: 24px;
            font-weight: 400;
            line-height: 1.1;
            letter-spacing: -.5px
        }

        .stat span {
            font-size: 11.5px;
            color: var(--ink-3)
        }

        .stat.s1 b {
            color: var(--blue-g)
        }

        .stat.s2 b {
            color: var(--red-g)
        }

        .stat.s3 b {
            color: var(--yellow)
        }

        .stat.s4 b {
            color: var(--green-g)
        }

        .profiles {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin: 30px 0 26px
        }

        .pcard {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: var(--r);
            padding: 20px 22px;
            border-top: 3px solid var(--blue)
        }

        .pcard.p2 {
            border-top-color: var(--green)
        }

        .pcard h3 {
            margin: 0 0 3px;
            font-size: 16px;
            font-weight: 500;
            color: var(--blue-d);
            display: flex;
            align-items: center;
            gap: 9px
        }

        .pcard.p2 h3 {
            color: var(--green)
        }

        .pcard h3 .swatch {
            width: 13px;
            height: 13px;
            border-radius: 4px;
            background: var(--blue-bg);
            border: 1.5px solid var(--blue)
        }

        .pcard.p2 h3 .swatch {
            background: var(--green-bg);
            border-color: var(--green)
        }

        .pcard p {
            margin: 0 0 12px;
            font-size: 12.5px;
            color: var(--ink-3)
        }

        .pcard ul {
            margin: 0;
            padding: 0;
            list-style: none
        }

        .pcard li {
            position: relative;
            padding-left: 18px;
            font-size: 13px;
            margin-bottom: 6px;
            color: var(--ink)
        }

        .pcard li::before {
            content: "";
            position: absolute;
            left: 0;
            top: 8px;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--blue)
        }

        .pcard.p2 li::before {
            background: var(--green)
        }

        .legend-strip {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
            align-items: center;
            padding-top: 22px;
            border-top: 1px solid var(--line)
        }

        .legend-strip .lk {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 20px;
            padding: 6px 13px 6px 7px;
            font-size: 12px;
            color: var(--ink-2)
        }

        /* ===== SECCIONES ===== */
        .doc-section {
            margin-bottom: 80px;
            scroll-margin-top: calc(var(--top) + 84px)
        }

        .sec-head {
            margin-bottom: 26px
        }

        .sec-kicker {
            display: inline-block;
            font-size: 11.5px;
            font-weight: 700;
            color: var(--blue);
            background: var(--blue-bg);
            border-radius: 6px;
            padding: 3px 10px;
            margin-bottom: 12px
        }

        .sec-head h1 {
            font-size: 29px;
            font-weight: 400;
            line-height: 1.22;
            margin: 0;
            letter-spacing: -.6px;
            max-width: 26ch
        }

        .lead {
            font-size: 15.5px;
            color: var(--ink-2);
            max-width: 74ch;
            margin: 18px 0 0;
            line-height: 1.66
        }

        .lead-sub {
            font-size: 14.5px;
            color: var(--ink-2);
            max-width: 74ch;
            margin: 10px 0 0;
            line-height: 1.65
        }

        .sec-head h1 {
            position: relative
        }

        .sec-head h1::after {
            content: "";
            display: block;
            width: 56px;
            height: 3px;
            border-radius: 2px;
            margin-top: 16px;
            background: linear-gradient(90deg, var(--blue-g) 0 25%, var(--red-g) 25% 50%, var(--yellow-g) 50% 75%, var(--green-g) 75% 100%)
        }

        .p-strong {
            background: var(--surface);
            border-left: 3px solid var(--blue-line);
            border-radius: 0 10px 10px 0;
            padding: 12px 16px;
            margin: 0 0 16px;
            max-width: 76ch
        }

        .p-strong strong {
            color: var(--blue-d)
        }

        .card .p-strong {
            background: #f6f8fc
        }

        /* ===== TARJETAS ===== */
        .card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: var(--r);
            padding: 24px 26px 8px;
            margin-bottom: 18px;
            box-shadow: var(--shadow)
        }

        .card-plain {
            padding-bottom: 8px
        }

        .card-head {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
            flex-wrap: wrap
        }

        .card-num {
            flex: none;
            min-width: 38px;
            height: 24px;
            padding: 0 8px;
            border-radius: 7px;
            background: var(--blue-bg);
            color: var(--blue-d);
            font-size: 12px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-variant-numeric: tabular-nums;
            position: relative;
            top: -1px
        }

        .card h2 {
            font-size: 17.5px;
            font-weight: 500;
            margin: 0;
            color: var(--ink);
            letter-spacing: -.2px
        }

        .card-body>*:last-child {
            margin-bottom: 16px
        }

        .card h3 {
            font-size: 14px;
            font-weight: 500;
            margin: 24px 0 10px;
            color: var(--blue-d)
        }

        /* ===== BARRA DE RUTA ===== */
        .routebar {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 6px;
            margin: 0 0 18px;
            background: linear-gradient(90deg, var(--blue-bg), rgba(232, 240, 254, .35));
            border: 1px solid var(--blue-line);
            border-radius: 10px;
            padding: 9px 14px;
            font-size: 12.5px
        }

        .routebar>svg {
            color: var(--blue);
            flex: none;
            margin-right: 2px
        }

        .rseg {
            color: var(--blue-d);
            font-weight: 500;
            font-family: var(--mono);
            font-size: 11.5px
        }

        .rseg:last-child {
            background: #fff;
            border: 1px solid var(--blue-line);
            border-radius: 6px;
            padding: 2px 8px
        }

        .rsep {
            color: var(--blue);
            opacity: .5
        }

        /* ===== TEXTO ===== */
        p {
            margin: 0 0 14px;
            max-width: 76ch
        }

        ul,
        ol {
            margin: 0 0 16px;
            padding-left: 0;
            max-width: 76ch;
            list-style: none
        }

        li {
            position: relative;
            padding-left: 22px;
            margin-bottom: 8px
        }

        ul>li::before {
            content: "";
            position: absolute;
            left: 4px;
            top: 9px;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--blue);
            opacity: .8
        }

        ol {
            counter-reset: n
        }

        ol>li {
            counter-increment: n;
            padding-left: 30px
        }

        ol>li::before {
            content: counter(n);
            position: absolute;
            left: 0;
            top: 1px;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: var(--blue-bg);
            color: var(--blue-d);
            font-size: 11px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center
        }

        li>ul {
            margin: 8px 0 0
        }

        li>ul>li::before {
            background: var(--ink-3);
            width: 5px;
            height: 5px
        }

        a {
            color: var(--blue)
        }

        strong {
            font-weight: 500;
            color: var(--ink)
        }

        em {
            font-style: italic;
            color: var(--ink-2)
        }

        code {
            font-family: var(--mono);
            font-size: 12px;
            background: var(--surface);
            border: 1px solid var(--line-soft);
            border-radius: 5px;
            padding: 1.5px 6px;
            color: var(--blue-d);
            word-break: break-word
        }

        pre {
            background: #1f2023;
            color: #e8eaed;
            border-radius: 12px;
            padding: 18px 20px;
            overflow-x: auto;
            font-family: var(--mono);
            font-size: 12.5px;
            line-height: 1.6;
            margin: 0 0 18px;
            max-width: 76ch
        }

        pre code {
            background: none;
            border: 0;
            color: inherit;
            padding: 0
        }

        hr {
            border: 0;
            border-top: 1px solid var(--line);
            margin: 28px 0
        }

        .callout {
            margin: 0 0 18px;
            padding: 15px 18px 15px 46px;
            background: var(--yellow-bg);
            border: 1px solid #fde293;
            border-radius: 12px;
            position: relative;
            max-width: 76ch
        }

        .callout::before {
            content: "!";
            position: absolute;
            left: 16px;
            top: 15px;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: var(--yellow);
            color: #fff;
            font-size: 13px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center
        }

        .callout p {
            margin: 0 0 8px;
            max-width: none
        }

        .callout p:last-child {
            margin: 0
        }

        .warnbox,
        .homebox {
            margin: 0 0 18px;
            padding: 14px 18px;
            border-radius: 12px;
            max-width: 76ch;
            border: 1px solid;
            line-height: 1.6
        }

        .warnbox {
            background: var(--red-bg);
            border-color: #f6c7c2
        }

        .homebox {
            background: var(--purple-bg);
            border-color: #e5cffa
        }

        .warnbox strong,
        .homebox strong {
            color: var(--ink)
        }

        /* ===== TABLAS ===== */
        .table-wrap {
            overflow-x: auto;
            margin: 0 0 18px;
            border: 1px solid var(--line);
            border-radius: 12px
        }

        table {
            border-collapse: collapse;
            width: 100%;
            font-size: 13px;
            background: #fff
        }

        th,
        td {
            padding: 11px 14px;
            text-align: left;
            vertical-align: top;
            border-bottom: 1px solid var(--line-soft)
        }

        thead th {
            background: var(--surface);
            font-weight: 500;
            font-size: 11.5px;
            color: var(--ink-2);
            border-bottom: 1px solid var(--line)
        }

        tbody tr:last-child td {
            border-bottom: 0
        }

        tbody tr:hover td {
            background: #fcfcfd
        }

        td:first-child {
            font-weight: 500;
            min-width: 148px
        }

        thead th.col-alumnos {
            background: var(--blue-bg);
            color: var(--blue-d);
            font-weight: 700;
            box-shadow: inset 0 -3px 0 var(--blue)
        }

        thead th.col-personal {
            background: var(--green-bg);
            color: var(--green);
            font-weight: 700;
            box-shadow: inset 0 -3px 0 var(--green)
        }

        th.col-alumnos,
        td.col-alumnos {
            border-left: 2px solid var(--blue-line);
            border-right: 2px solid var(--blue-line)
        }

        th.col-personal,
        td.col-personal {
            border-left: 2px solid var(--green-line);
            border-right: 2px solid var(--green-line)
        }

        td.col-alumnos {
            background: #eef3fd
        }

        td.col-personal {
            background: #edf6f0
        }

        tbody tr:hover td.col-alumnos {
            background: #e3edfc
        }

        tbody tr:hover td.col-personal {
            background: #e0f1e6
        }

        body.only-alumnos .col-personal {
            opacity: .2;
            filter: grayscale(1)
        }

        body.only-personal .col-alumnos {
            opacity: .2;
            filter: grayscale(1)
        }

        .col-alumnos,
        .col-personal {
            transition: opacity .18s ease
        }

        /* ===== CHIPS ===== */
        .chip {
            display: inline-flex;
            align-items: center;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .3px;
            padding: 2.5px 8px;
            border-radius: 20px;
            margin: 0 6px 3px 0;
            white-space: nowrap;
            vertical-align: 1px
        }

        .chip-key {
            background: var(--yellow-bg);
            color: var(--yellow-ink);
            border: 1px solid #fde293
        }

        .chip-home {
            background: var(--purple-bg);
            color: var(--purple);
            border: 1px solid #e5cffa
        }

        .chip-warn {
            background: var(--red-bg);
            color: var(--red);
            border: 1px solid #f6c7c2
        }

        td:first-child .chip {
            display: inline-flex
        }

        /* ===== TOOLBAR ===== */
        .toolbar {
            position: sticky;
            top: var(--top);
            z-index: 35;
            display: flex;
            align-items: center;
            gap: 18px;
            flex-wrap: wrap;
            padding: 10px 18px;
            margin: 0 0 26px;
            border-radius: 14px;
            background: rgba(255, 255, 255, .86);
            backdrop-filter: blur(14px) saturate(160%);
            -webkit-backdrop-filter: blur(14px) saturate(160%);
            border: 1px solid var(--line);
            box-shadow: 0 4px 18px -10px rgba(60, 64, 67, .45)
        }

        .prog {
            display: flex;
            align-items: center;
            gap: 12px;
            flex: 1;
            min-width: 220px
        }

        .prog-bar {
            flex: 1;
            max-width: 280px;
            height: 8px;
            border-radius: 6px;
            background: var(--line-soft);
            overflow: hidden
        }

        .prog-bar i {
            display: block;
            height: 100%;
            width: 0;
            border-radius: 6px;
            transition: width .3s ease;
            background: linear-gradient(90deg, var(--blue-g), var(--green-g))
        }

        .prog-txt {
            display: flex;
            flex-direction: column;
            line-height: 1.2
        }

        .prog-txt b {
            font-size: 14px;
            font-weight: 500;
            font-variant-numeric: tabular-nums
        }

        .prog-txt em {
            font-style: normal;
            font-size: 11px;
            color: var(--ink-3)
        }

        .tb-right {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap
        }

        .tb-btn {
            border: 1px solid var(--line);
            background: #fff;
            border-radius: 20px;
            padding: 8px 15px;
            font: inherit;
            font-size: 12.5px;
            font-weight: 500;
            color: var(--ink-2);
            cursor: pointer;
            white-space: nowrap
        }

        .tb-btn:hover {
            background: var(--surface);
            color: var(--ink)
        }

        .tb-btn.primary {
            background: var(--blue);
            border-color: var(--blue);
            color: #fff
        }

        .tb-btn.primary:hover {
            background: var(--blue-d);
            color: #fff
        }

        .tb-btn.ghost {
            border-color: transparent;
            color: var(--ink-3);
            padding: 8px 11px
        }

        .tb-btn.ghost:hover {
            background: var(--surface)
        }

        .tb-btn.danger:hover {
            color: var(--red);
            background: var(--red-bg)
        }

        .tb-btn[aria-pressed="true"] {
            background: var(--ink);
            border-color: var(--ink);
            color: #fff
        }

        /* ===== CHECKLIST ===== */
        .ck-cell {
            position: relative;
            padding-left: 40px !important
        }

        .tick {
            position: absolute;
            left: 12px;
            top: 11px;
            width: 19px;
            height: 19px;
            border-radius: 6px;
            border: 2px solid var(--blue-line);
            background: #fff;
            cursor: pointer;
            padding: 0;
            display: grid;
            place-items: center;
            transition: .14s
        }

        td.col-personal .tick {
            border-color: var(--green-line)
        }

        .tick svg {
            width: 12px;
            height: 12px;
            color: #fff;
            opacity: 0;
            transform: scale(.6);
            transition: .14s
        }

        .tick:hover {
            border-color: var(--blue)
        }

        td.col-personal .tick:hover {
            border-color: var(--green)
        }

        .tick[aria-checked="true"] {
            background: var(--blue);
            border-color: var(--blue)
        }

        td.col-personal .tick[aria-checked="true"] {
            background: var(--green);
            border-color: var(--green)
        }

        .tick[aria-checked="true"] svg {
            opacity: 1;
            transform: scale(1)
        }

        td.ck-cell.is-done .ck-val {
            opacity: .5
        }

        tr.done td:first-child {
            opacity: .55
        }

        .card-prog {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 9px;
            flex: none
        }

        .card-prog i {
            display: block;
            width: 56px;
            height: 6px;
            border-radius: 4px;
            background: var(--line-soft);
            overflow: hidden;
            position: relative
        }

        .card-prog i::after {
            content: "";
            position: absolute;
            inset: 0 auto 0 0;
            width: var(--w, 0%);
            border-radius: 4px;
            background: linear-gradient(90deg, var(--blue-g), var(--green-g))
        }

        .card-prog b {
            font-size: 11px;
            font-weight: 500;
            color: var(--ink-3);
            font-variant-numeric: tabular-nums
        }

        .card.all-done .card-num {
            background: var(--green-bg);
            color: var(--green)
        }

        .nav-count {
            margin-left: auto;
            font-size: 10px;
            font-weight: 500;
            color: var(--ink-3);
            font-variant-numeric: tabular-nums;
            flex: none;
            padding-left: 8px
        }

        .nav-item.done-all .nav-count {
            color: var(--green)
        }

        body.only-pending tr.done {
            display: none
        }

        body.only-pending .card.all-done {
            display: none
        }

        body.only-pending .doc-section.all-done {
            display: none
        }

        /* ===== MODAL ===== */
        .modal {
            position: fixed;
            inset: 0;
            z-index: 80;
            background: rgba(32, 33, 36, .55);
            display: grid;
            place-items: center;
            padding: 20px
        }

        .modal[hidden] {
            display: none
        }

        .sheet {
            background: #fff;
            border-radius: 20px;
            width: min(760px, 100%);
            max-height: 90vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 30px 80px -20px rgba(0, 0, 0, .5)
        }

        .sheet-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 24px 14px;
            border-bottom: 1px solid var(--line)
        }

        .sheet-head h3 {
            margin: 0;
            font-size: 17px;
            font-weight: 500
        }

        .x {
            border: 0;
            background: transparent;
            font-size: 26px;
            line-height: 1;
            color: var(--ink-3);
            cursor: pointer;
            padding: 0 4px
        }

        .sheet-body {
            padding: 20px 24px;
            overflow-y: auto
        }

        .sheet-note {
            font-size: 12.5px;
            color: var(--ink-3);
            margin: 0 0 18px;
            max-width: none
        }

        .grid2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px
        }

        .sheet label {
            display: block;
            font-size: 11.5px;
            font-weight: 500;
            color: var(--ink-2)
        }

        .sheet label.full {
            margin-top: 14px
        }

        .sheet input,
        .sheet textarea {
            width: 100%;
            margin-top: 5px;
            border: 1px solid var(--line);
            border-radius: 9px;
            padding: 9px 12px;
            font: inherit;
            font-size: 13.5px;
            color: var(--ink);
            outline: none;
            background: #fff
        }

        .sheet input:focus,
        .sheet textarea:focus {
            border-color: var(--blue);
            box-shadow: 0 0 0 3px rgba(26, 115, 232, .14)
        }

        .sheet-stats {
            margin-top: 18px;
            border: 1px solid var(--line);
            border-radius: 12px;
            overflow: hidden;
            display: grid;
            grid-template-columns: repeat(3, 1fr)
        }

        .sheet-stats div {
            padding: 12px 16px;
            border-right: 1px solid var(--line-soft)
        }

        .sheet-stats div:last-child {
            border-right: 0
        }

        .sheet-stats b {
            display: block;
            font-size: 19px;
            font-weight: 400
        }

        .sheet-stats span {
            font-size: 11px;
            color: var(--ink-3)
        }

        .sheet-foot {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 14px 24px;
            border-top: 1px solid var(--line);
            flex-wrap: wrap
        }

        .foot-left,
        .foot-right {
            display: flex;
            gap: 8px;
            flex-wrap: wrap
        }

        @media (max-width:640px) {
            .grid2 {
                grid-template-columns: 1fr
            }

            .sheet-stats {
                grid-template-columns: 1fr
            }
        }

        /* ===== MISC ===== */
        .fab {
            position: fixed;
            right: 26px;
            bottom: 26px;
            width: 46px;
            height: 46px;
            border-radius: 50%;
            border: 1px solid var(--line);
            background: #fff;
            box-shadow: 0 4px 14px rgba(60, 64, 67, .22);
            cursor: pointer;
            display: none;
            place-items: center;
            color: var(--ink-2);
            z-index: 40
        }

        .fab.show {
            display: grid
        }

        .scrim {
            position: fixed;
            inset: 0;
            background: rgba(32, 33, 36, .5);
            z-index: 45;
            display: none
        }

        @media (max-width:1080px) {
            .topnav {
                display: none
            }
        }

        @media (max-width:960px) {
            .profiles {
                grid-template-columns: 1fr
            }
        }

        @media (max-width:900px) {
            :root {
                --top: 106px
            }

            .burger {
                display: block
            }

            .topbar {
                flex-wrap: wrap;
                height: var(--top);
                padding: 8px 12px;
                row-gap: 8px;
                align-content: center
            }

            .brand {
                flex: 1;
                min-width: 0;
                gap: 8px
            }

            .brand-text span {
                display: none
            }

            .filter {
                order: 2;
                flex: none
            }

            .filter button {
                padding: 7px 11px
            }

            .search {
                order: 3;
                flex: 0 0 100%;
                max-width: none
            }

            .search input {
                height: 38px
            }

            .sidebar {
                transform: translateX(-100%);
                transition: transform .2s ease;
                background: #fff;
                box-shadow: 0 8px 28px rgba(60, 64, 67, .3)
            }

            body.nav-open .sidebar {
                transform: none
            }

            body.nav-open .scrim {
                display: block
            }

            main {
                margin-left: 0;
                padding: calc(var(--top) + 18px) 15px 100px
            }

            .hero {
                padding: 34px 22px 28px;
                border-radius: 20px
            }

            .card {
                padding: 20px 18px 6px;
                border-radius: 14px
            }

            .sec-head h1 {
                font-size: 24px
            }

            .stats {
                grid-template-columns: repeat(2, 1fr)
            }

            .stat {
                padding: 12px 16px
            }

            .stat:nth-child(2n) {
                border-right: 0
            }

            .stat:nth-child(-n+2) {
                border-bottom: 1px solid var(--line-soft)
            }
        }

        @media (max-width:640px) {
            .brand-text {
                display: none
            }

            .filter button {
                padding: 7px 10px;
                font-size: 11.5px
            }

            .hero h1 {
                letter-spacing: -.6px
            }
        }

        @media print {

            .topbar,
            .sidebar,
            .fab,
            .scrim,
            .orbs,
            .grain,
            .toolbar,
            .modal,
            .tick {
                display: none !important
            }

            .ck-cell {
                padding-left: 14px !important
            }

            main {
                margin: 0;
                padding: 0;
                max-width: none
            }

            .hero {
                border: 0;
                padding: 0;
                box-shadow: none;
                background: none
            }

            .doc-section {
                page-break-before: always;
                margin-bottom: 24px
            }

            .doc-section:first-of-type {
                page-break-before: auto
            }

            .card {
                box-shadow: none;
                break-inside: avoid;
                page-break-inside: avoid
            }

            tr {
                break-inside: avoid
            }

            body {
                font-size: 9.5pt
            }
        }

        @media (prefers-reduced-motion:reduce) {
            html {
                scroll-behavior: auto
            }

            * {
                transition: none !important
            }
        }

        :focus-visible {
            outline: 2px solid var(--blue);
            outline-offset: 2px;
            border-radius: 4px
        }
    </style>
</head>

<body>

    <div class="orbs" aria-hidden="true">
        <div class="orb o1"></div>
        <div class="orb o2"></div>
        <div class="orb o3"></div>
        <div class="orb o4"></div>
        <div class="orb o5"></div>
        <div class="orb o6"></div>
    </div>
    <div class="grain" aria-hidden="true"></div>

    <header class="topbar">
        <div class="brand">
            <button class="burger" id="burger" aria-label="Abrir navegación">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" />
                </svg>
            </button>
            <div class="logo"></div>
            <div class="brand-text"><b>Manual de blindaje</b><span>Google Admin Console · Chromebooks 1:1</span></div>
        </div>
        <div class="search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path
                    d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
            </svg>
            <input id="q" type="search" placeholder="Buscar una ruta o un ajuste" autocomplete="off"
                aria-label="Buscar">
        </div>
        <nav class="topnav" id="topnav"><a class="top-link"
                href="#sec-parte-0-arquitectura-previa-unidades-organizativas">Parte 0</a><a class="top-link"
                href="#sec-parte-1-cuenta-y-directorio">Parte 1</a><a class="top-link"
                href="#sec-parte-2-seguridad-identidad-acceso-y-datos">Parte 2</a><a class="top-link"
                href="#sec-parte-3-servicios-de-google-workspace">Parte 3</a><a class="top-link"
